# ------------------------------------------------------------------
# 1. Python Artifacts
# ------------------------------------------------------------------

# Bytecode, compiled files, and metadata
__pycache__/
*.py[cod]
*.pyc
*.so
.Python

# Environment files
env/
venv/
.venv

# Package metadata/build artifacts
*.egg-info/
*$py.class

# Log files and database/large data files
*.h5
*.log

# ------------------------------------------------------------------
# 2. Data Files (Ignoring all contents, but preserving .gitkeep)
# ------------------------------------------------------------------

data/raw/
data/interim/
data/processed/
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ------------------------------------------------------------------
# 3. IDE and System Files
# ------------------------------------------------------------------

# Common IDE configuration files
.vscode/
.idea/
*.swp

# Operating System files
.DS_Store
Thumbs.db