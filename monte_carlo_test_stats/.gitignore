# ------------------------------------------------------------------
# 1. Python Artifacts
# ------------------------------------------------------------------

# Bytecode, compiled files, and metadata
__pycache__/
*.py[cod]
*.pyc
*.so
.Python

# Environment files
env/
venv/
.venv

# Package metadata/build artifacts
*.egg-info/
*$py.class

# Log files and database/large data files
*.h5
*.log

# ------------------------------------------------------------------
# 2. Data Files (Ignoring all contents, but preserving .gitkeep)
# ------------------------------------------------------------------

data/raw/
data/interim/
data/processed/
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ------------------------------------------------------------------
# 3. IDE and System Files
# ------------------------------------------------------------------

# Common IDE configuration files
.vscode/
.idea/
*.swp

# Operating System files
.DS_Store
Thumbs.db

# ------------------------------------------------------------------
# 4. Generated Artifacts (Graphs, Reports)
# ------------------------------------------------------------------

# Ignore all contents of these dedicated reports directories
reports/ .gitkeep
reports/figures/*
!reports/figures/.gitkeep
reports/quantile_tables/*
!reports/quantile_tables/.gitkeep
reports/cross_validation/*
!reports/cross_validation/.gitkeep
reports/master_validation/*
!reports/master_validation/.gitkeep
reports/type_i_error_analysis/*
!reports/type_i_error_analysis/.gitkeep